# Database
# docker-entrypoint.sh builds DATABASE_URL from the split PostgreSQL settings below.
# You may still set DATABASE_URL directly when you need a fully custom connection string.
POSTGRES_HOST="db.example.com"
POSTGRES_PORT="5432"
POSTGRES_USER="user_service"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="user_service"
POSTGRES_SCHEMA="public"
POSTGRES_SSLMODE=""
POSTGRES_URL_EXTRA_PARAMS=""

# JWT
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-change-in-production"

# Demo third-party app integration
# Run `npm run db:seed` to create this demo application locally.
USER_SERVICE_BASE_URL="http://localhost:3000"
DEMO_APP_BASE_URL="http://localhost:3000"
DEMO_APP_ID="demo-business-app"
DEMO_APP_SECRET="sk_demo_business_app_secret"

# Docker Compose deployment
USER_SERVICE_IMAGE="ghcr.io/your-github-owner/user-service:latest"
USER_SERVICE_PORT="3000"
USER_SERVICE_CONTAINER_NAME="user-service"
