generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  phone        String?    @unique
  username     String     @unique
  passwordHash String
  avatar       String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  userRoles           UserRole[]
  sessions            Session[]
  authCodes           AuthCode[]
  auditLogs           AuditLog[]
  managedApplications ApplicationManager[]
  applicationUsers    ApplicationUser[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  refreshToken String   @unique
  expiresAt    DateTime
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Application {
  id             String                @id @default(cuid())
  name           String                @unique
  description    String?
  apiKey         String                @unique
  apiSecret      String
  status         AppStatus             @default(ACTIVE)
  accessMode     ApplicationAccessMode @default(OPEN)
  callbackUrl    String?
  allowedOrigins String[]              @default([])
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  authCodes AuthCode[]
  managers  ApplicationManager[]
  users     ApplicationUser[]

  @@map("applications")
}

enum AppStatus {
  ACTIVE
  DISABLED
}

enum ApplicationAccessMode {
  OPEN
  MEMBERS_ONLY
  ADMINS_ONLY
}

enum ApplicationUserStatus {
  ACTIVE
  DISABLED
}

model ApplicationManager {
  id        String   @id @default(cuid())
  appId     String
  userId    String
  createdAt DateTime @default(now())

  application Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appId, userId])
  @@index([userId])
  @@map("application_managers")
}

model ApplicationUser {
  id          String                @id @default(cuid())
  appId       String
  userId      String
  status      ApplicationUserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  application Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appId, userId])
  @@index([userId])
  @@index([status])
  @@map("application_users")
}

model AuthCode {
  id          String   @id @default(cuid())
  code        String   @unique
  appId       String
  userId      String
  redirectUri String
  state       String?
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())

  application Application @relation(fields: [appId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([expiresAt])
  @@map("auth_codes")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  detail    Json?
  ip        String?
  traceId   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@index([traceId])
  @@map("audit_logs")
}
