# Development environment
# Copy this file to `.env` when using docker-compose.dev.yml:
# cp .env.dev.example .env

# docker-compose.dev.yml starts PostgreSQL in the same Compose network.
# The app container overrides POSTGRES_HOST to `postgres`.
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="user_service"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="user_service"
POSTGRES_SCHEMA="public"
POSTGRES_SSLMODE=""
POSTGRES_URL_EXTRA_PARAMS=""
POSTGRES_CONTAINER_NAME="user-service-postgres-dev"

# If you run the app directly on the host with `npm run dev`, uncomment this.
# Keep it commented when running the app container with docker-compose.dev.yml.
# DATABASE_URL="postgresql://user_service:change-me@localhost:5432/user_service?schema=public"

# JWT
JWT_SECRET="dev-jwt-secret"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret"

# Demo third-party app integration
USER_SERVICE_BASE_URL="http://localhost:3000"
DEMO_APP_BASE_URL="http://localhost:3000"
DEMO_APP_ID="demo-business-app"
DEMO_APP_SECRET="sk_demo_business_app_secret"

# Docker Compose development deployment
USER_SERVICE_PORT="3000"
USER_SERVICE_CONTAINER_NAME="user-service-dev"
